  "author": {
    "name": "Quarto Authors, RStudio, PBC.",
    "url": "https://quarto.org"
  },
  "license": "ISC",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "jsdelivr": "dist/runtime.umd.js",
  "unpkg": "dist/runtime.umd.js",
  "exports": {
    "umd": "./dist/runtime.umd.js",
    "default": "./src/index.js"
  },
  "repository": {
    "type": "git",
